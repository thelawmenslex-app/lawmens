__d(function(e,o,t,i,n,a,r){n.exports={categories:[{_id:{$oid:"6657528684091c0faa66efd6"},name:"Indian Penal Code , 1860",type:"old",isActive:!0,createdAt:{$date:"2024-05-27T16:06:30.146Z"},updatedAt:{$date:"2024-05-29T16:06:30.146Z"},image:"/category/5.png",parentId:"6657529c84091c0faa66efdf",act:"Identified as Act no. 45 of 1860, commonly referred to as the Indian Penal Code, 1860, this Act comprises twenty-three chapters and 511 sections. It came into force on 1st January 1862 and applies to the whole of India except the state of Jammu and Kashmir (Note: Post the abrogation of Article 370, IPC now also applies to Jammu and Kashmir). The IPC lays down the definitions of various crimes and prescribes the punishments for them."},{_id:{$oid:"6657528b84091c0faa66efd9"},name:"Code of Criminal Procedure ,1973",type:"old",isActive:!0,createdAt:{$date:"2024-05-26T16:06:35.523Z"},updatedAt:{$date:"2024-05-29T16:06:35.523Z"},image:"/category/6.png",parentId:"665752a184091c0faa66efe2",act:"Identified as Act no. 2 of 1974, commonly referred to as the Code of Criminal Procedure, 1973, this Act comprises thirty-seven chapters and 484 sections, along with two schedules. It came into force on 1st April 1974 and applies to the whole of India except the state of Jammu and Kashmir (Note: Post the abrogation of Article 370, CrPC now also applies to Jammu and Kashmir). The CrPC lays down the procedure for the administration of substantive criminal law in India."},{_id:{$oid:"6657529084091c0faa66efdc"},name:"India Evidence Act, 1872",type:"old",isActive:!0,createdAt:{$date:"2024-05-25T16:06:40.743Z"},updatedAt:{$date:"2024-05-29T16:06:40.743Z"},image:"/category/4.png",parentId:"665752a784091c0faa66efe5",act:"Identified as Act no. 1 of 1872, commonly referred to as the Indian Evidence Act, 1872, this Act has eleven chapters and 167 sections. It came into force on 1st September 1872 and applies to all of India except the state of Jammu and Kashmir."},{_id:{$oid:"6657529c84091c0faa66efdf"},name:"Bharatiya Nyaya Sanhita , 2023",type:"new",isActive:!0,createdAt:{$date:"2024-05-30T16:06:52.229Z"},updatedAt:{$date:"2026-07-17T13:40:49.783Z"},image:"/category/2.png",parentId:"6657528684091c0faa66efd6",act:"The Bharatiya Nyaya Sanhita (BNS) is the official criminal code in the Republic of India. It was introduced in December 2023 to replace the Indian Penal Code (IPC), which dated back to the period of British India. It will come into effect on July 1, 2024."},{_id:{$oid:"665752a184091c0faa66efe2"},name:"Bharatiya Nagarik Suraksha Sanhita , 2023",type:"new",isActive:!0,createdAt:{$date:"2024-05-29T16:06:57.550Z"},updatedAt:{$date:"2026-07-17T12:28:10.427Z"},image:"/category/3.png",parentId:"6657528b84091c0faa66efd9",act:"The Bharatiya Nagarik Suraksha Sanhita (BNSS) is the official code of criminal procedure in the Republic of India. It was introduced in December 2023 to replace the Code of Criminal Procedure (CrPC), which dated back to the period of British India. It will come into effect on July 1, 2024.",firstScheduleHtml:"<p class=\"MsoNormal\"><span lang=\"EN-US\">\x3c!--[if gte vml 1]><v:shapetype\n id=\"_x0000_t75\" coordsize=\"21600,21600\" o:spt=\"75\" o:preferrelative=\"t\"\n path=\"m@4@5l@4@11@9@11@9@5xe\" filled=\"f\" stroked=\"f\">\n <v:stroke joinstyle=\"miter\"/>\n <v:formulas>\n  <v:f eqn=\"if lineDrawn pixelLineWidth 0\"/>\n  <v:f eqn=\"sum @0 1 0\"/>\n  <v:f eqn=\"sum 0 0 @1\"/>\n  <v:f eqn=\"prod @2 1 2\"/>\n  <v:f eqn=\"prod @3 21600 pixelWidth\"/>\n  <v:f eqn=\"prod @3 21600 pixelHeight\"/>\n  <v:f eqn=\"sum @0 0 1\"/>\n  <v:f eqn=\"prod @6 1 2\"/>\n  <v:f eqn=\"prod @7 21600 pixelWidth\"/>\n  <v:f eqn=\"sum @8 21600 0\"/>\n  <v:f eqn=\"prod @7 21600 pixelHeight\"/>\n  <v:f eqn=\"sum @10 21600 0\"/>\n </v:formulas>\n <v:path o:extrusionok=\"f\" gradientshapeok=\"t\" o:connecttype=\"rect\"/>\n <o:lock v:ext=\"edit\" aspectratio=\"t\"/>\n</v:shapetype><v:shape id=\"Picture_x0020_1\" o:spid=\"_x0000_i1057\" type=\"#_x0000_t75\"\n style='